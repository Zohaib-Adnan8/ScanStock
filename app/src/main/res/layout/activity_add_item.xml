<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A1A2E"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✏️ Add Item"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fill in the details and save"
                android:textColor="#AAB4D4"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:layout_margin="16dp"
            android:padding="16dp">

            <!-- Barcode Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barcode (auto-filled from scan)"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etBarcode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Barcode number"
                android:backgroundTint="#E0E4F0"
                android:padding="10dp"
                android:textSize="14sp"
                android:inputType="text"/>

            <!-- Item Name Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Item Name *"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Java Programming Book"
                android:backgroundTint="#E0E4F0"
                android:padding="10dp"
                android:textSize="14sp"
                android:inputType="text"/>

            <!-- Quantity Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quantity *"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. 5"
                android:backgroundTint="#E0E4F0"
                android:padding="10dp"
                android:textSize="14sp"
                android:inputType="number"/>

            <!-- Category Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#E0E4F0"
                android:padding="4dp"/>

            <!-- Notes Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notes (optional)"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Any extra notes..."
                android:backgroundTint="#E0E4F0"
                android:padding="10dp"
                android:textSize="14sp"
                android:gravity="top"
                android:inputType="textMultiLine"/>

        </LinearLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="💾 Save to Inventory"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#4F46E5"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>

        <!-- Cancel Button -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="✖ Cancel"
            android:textColor="#888888"
            android:textSize="14sp"
            android:backgroundTint="#E0E4F0"
            android:layout_margin="16dp"/>

    </LinearLayout>

</ScrollView>